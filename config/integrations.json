{
  "schema_version": 2,
  "role": "personal_system_integration_hub",
  "principle": "small_apps_collect_or_specialize; Nayvadius integrates canonical state and downstream knowledge views",
  "record_contract": {
    "required": ["id", "content", "source"],
    "recommended": ["title", "metadata", "tags", "entities", "relations", "related_ids", "importance", "document_type"],
    "provenance_rule": "Every imported record keeps its source and upstream identifier; normalized and derived facts must remain distinguishable from raw source data."
  },
  "sources": [
    {
      "id": "abraham",
      "domain": "knowledge",
      "role": "knowledge_admission",
      "upstream_repo": "yoonchoi96-jpg/abraham",
      "contract": "data/abraham_export.jsonl",
      "ownership": ["selection", "rating", "translation", "entity_extraction", "relation_extraction"]
    },
    {
      "id": "abel",
      "domain": "language",
      "role": "vocabulary_source",
      "upstream_repo": "yoonchoi96-jpg/abel",
      "contract": "Abel vocabulary export",
      "ownership": ["Naver Dictionary collection", "HSK curation", "wordbooks"]
    },
    {
      "id": "jacques",
      "domain": "music",
      "role": "music_intelligence_source",
      "upstream_repo": "yoonchoi96-jpg/Jacques",
      "contract": "data/jacques_export.json",
      "ownership": ["Spotify ingestion", "audio/enrichment", "editorial source sync", "music analysis"]
    }
  ],
  "integration": {
    "owner": "nayvadius",
    "responsibilities": [
      "canonicalization",
      "deduplication",
      "cross-source linking",
      "provenance",
      "evidence",
      "knowledge graph",
      "derived knowledge",
      "downstream Obsidian/Notion projection"
    ],
    "non_responsibilities": [
      "primary source collection",
      "domain-specific source scraping",
      "silent deletion of raw source facts"
    ]
  },
  "outputs": ["Obsidian", "Notion"]
}
